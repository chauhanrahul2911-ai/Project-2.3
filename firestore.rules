rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // A signed-in user can READ only their own document (to check their
      // own premium status) — but can no longer WRITE it themselves.
      // Only the Cloud Function webhook (using the Admin SDK, which
      // bypasses these rules entirely) is allowed to set "isPremium" now.
      // This is what actually makes premium tamper-proof.
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
  }
}
